# frontend/.env.production
# Used when building the frontend for production deployment.
# These values are baked into the static JS bundle at build time.
#
# IMPORTANT: Update VITE_API_BASE_URL to your actual Render API URL
# before running `npm run build` for production!

# Your Render API URL (replace with your actual Render service URL)
VITE_API_BASE_URL=https://rootcause-api.onrender.com/api/v1

# API key (must match ROOTCAUSE_API_KEYS on the Render service)
VITE_API_KEY=rca_92d6c92615c849759e0cc8523e8fc567
